{
	"name": "@atom-forge/brickee",
	"version": "0.0.4",
	"author": {
		"name": "Gergely Laborci",
		"url": "https://github.com/laborci"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/atom-forge/brickee.git"
	},
	"description": "A Svelte 5 block editor: markdown blocks plus plugins, stored as JSON",
	"license": "MIT",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && bun run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "(svelte-kit sync || true) && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"package": "svelte-package",
		"prepublishOnly": "bun run prepack",
		"pub-check": "ship-it check",
		"pub": "ship-it",
		"pub-validate": "ship-it validate",
		"deploy": "python3 deploy/local.py"
	},
	"ship": {
		"verify": [
			"bun run check",
			"bun run test",
			"bun run prepack",
			"npm pack --dry-run --ignore-scripts"
		]
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"README.md",
		"README-AI.md",
		"docs",
		"LICENSE",
		"CHANGELOG.md"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./plugins": {
			"types": "./dist/plugins/index.d.ts",
			"svelte": "./dist/plugins/index.js",
			"default": "./dist/plugins/index.js"
		},
		"./math": {
			"types": "./dist/math/index.d.ts",
			"svelte": "./dist/math/index.js",
			"default": "./dist/math/index.js"
		},
		"./schema": {
			"types": "./dist/schema.d.ts",
			"default": "./dist/schema.js"
		},
		"./model": {
			"types": "./dist/model.d.ts",
			"default": "./dist/model.js"
		},
		"./locales/*": {
			"types": "./dist/locales/*.d.ts",
			"default": "./dist/locales/*.js"
		}
	},
	"peerDependencies": {
		"@atom-forge/ui": ">=0.0.37",
		"@lucide/svelte": ">=1.0.0",
		"svelte": "^5.0.0",
		"temml": ">=0.13.0",
		"zod": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"temml": {
			"optional": true
		},
		"zod": {
			"optional": true
		}
	},
	"devDependencies": {
		"@atom-forge/ship": "0.2.0",
		"@atom-forge/ui": "^0.0.37",
		"@lucide/svelte": "^1.59.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"happy-dom": "^21.0.4",
		"pixelmatch": "^8.0.0",
		"playwright-core": "^1.65.0",
		"pngjs": "^7.0.0",
		"publint": "^0.3.15",
		"sass": "^1.108.2",
		"svelte": "^5.57.1",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.3.5",
		"temml": "^0.14.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^5.1.0",
		"zod": "^4.6.7"
	},
	"keywords": [
		"svelte",
		"block-editor",
		"markdown",
		"editor"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	}
}
